# Database - use either Postgres or MySQL connection string
# Postgres example:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaint_mgmt
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/complaint_mgmt

# Groq API
GROQ_API_KEY=your_groq_api_key_here
# Note: gemma2-9b-it and llama-3.3-70b-versatile were both deprecated by Groq
# on 2026-06-17. Using their recommended replacements below.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# CORS
FRONTEND_ORIGIN=http://localhost:5173
